{
  "name": "dataforge_w9_catalog",
  "displayName": "DataForge W9 filtered metadata catalog",
  "description": "W9-only catalog target. BigQuery metadata ingestion is authenticated in GitHub Actions through WIF ADC; no service-account key is stored.",
  "serviceType": "BigQuery",
  "connection": {
    "config": {
      "type": "BigQuery",
      "scheme": "bigquery",
      "hostPort": "bigquery.googleapis.com",
      "supportsMetadataExtraction": true,
      "supportsUsageExtraction": false,
      "supportsLineageExtraction": false,
      "supportsDBTExtraction": true,
      "supportsProfiler": false,
      "supportsQueryComment": false,
      "includePolicyTags": false,
      "credentials": {
        "gcpConfig": {
          "type": "gcp_adc",
          "projectId": ["dataforge-p7-lab-d0f725"]
        }
      }
    }
  }
}
