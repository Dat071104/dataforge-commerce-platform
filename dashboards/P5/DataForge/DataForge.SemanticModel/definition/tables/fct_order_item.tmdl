	column discount_pct
		dataType: decimal
		formatString: 0.00%
		lineageTag: 4afa11f5-6772-478c-9f7c-37382c72f29e
		summarizeBy: average
		sourceColumn: discount_pct

	column gross_item_value
		dataType: decimal
		formatString: #,##0.00
		lineageTag: eae8789a-f749-4ee6-990d-78e80a4feb8f
		summarizeBy: sum
		sourceColumn: gross_item_value

	column discount_value
		dataType: decimal
		formatString: #,##0.00
		lineageTag: ecb8cfa8-0281-4826-a6e9-ac77cfd09e6f
		summarizeBy: sum
		sourceColumn: discount_value

	column net_order_value
		dataType: decimal
		formatString: #,##0.00
		lineageTag: d861a5d5-5470-49d6-8793-2ded82f48969
		summarizeBy: sum
		sourceColumn: net_order_value

	column fulfilled_sales_proxy
		dataType: decimal
		formatString: #,##0.00
		lineageTag: 4c372200-ea85-4adc-8ac3-29b07eb6c29e
		summarizeBy: sum
		sourceColumn: fulfilled_sales_proxy

	column fulfilled_cogs_proxy
		dataType: decimal
		formatString: #,##0.00
		lineageTag: 749dec6e-a949-4d37-9de2-97d2f03bc580
		summarizeBy: sum
		sourceColumn: fulfilled_cogs_proxy

	partition fct_order_item = m
		mode: import
		source =
				let
				    Sheet = GoldWorkbook{[Item = "fct_order_item", Kind = "Sheet"]}[Data],
				    PromotedHeaders = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    TypedColumns = Table.TransformColumnTypes(
				        PromotedHeaders,
				        {
				            {"order_item_id", type text},
				            {"order_id", type text},
				            {"order_date_key", Int64.Type},
				            {"customer_key", Int64.Type},
				            {"product_key", Int64.Type},
				            {"geography_key", Int64.Type},
				            {"order_status", type text},
				            {"quantity", Int64.Type},
				            {"unit_price", Currency.Type},
				            {"discount_pct", Currency.Type},
				            {"gross_item_value", Currency.Type},
				            {"discount_value", Currency.Type},
				            {"net_order_value", Currency.Type},
				            {"fulfilled_sales_proxy", Currency.Type},
				            {"fulfilled_cogs_proxy", Currency.Type}
				        },
				        "en-US"
				    )
				in
				    TypedColumns

