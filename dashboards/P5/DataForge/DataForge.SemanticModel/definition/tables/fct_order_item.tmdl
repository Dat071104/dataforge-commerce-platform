table fct_order_item
	lineageTag: 91976ec0-fe04-4e47-9f06-05603fbaa319

	/// Delivered net item value; an analytics proxy, not recognized revenue.
	measure 'Fulfilled Sales Proxy' = SUM('fct_order_item'[fulfilled_sales_proxy])
		formatString: #,##0.00
		displayFolder: Currency (VND)
		lineageTag: 66cbe638-6ed8-42fa-897b-61efbfadb8a3

	/// Gross item value across all order statuses.
	measure 'Gross Ordered Value' = SUM('fct_order_item'[gross_item_value])
		formatString: #,##0.00
		displayFolder: Currency (VND)
		lineageTag: f0bb407b-312f-4394-a786-f99b5a1b7514

	/// Net item value across all order statuses; not revenue.
	measure 'Net Ordered Value' = SUM('fct_order_item'[net_order_value])
		formatString: #,##0.00
		displayFolder: Currency (VND)
		lineageTag: 47b27212-9624-4396-be7b-7eb06d700e23

	/// Distinct delivered orders within item-fact filter context.
	measure 'Delivered Orders' = CALCULATE(DISTINCTCOUNT('fct_order_item'[order_id]), 'fct_order_item'[order_status] = "delivered")
		formatString: #,##0
		displayFolder: Orders
		lineageTag: e1d94c4d-b86f-41c3-b379-20df1fccf5f2

	/// Unrounded fulfilled sales proxy per delivered order; model format is whole VND, Executive card overrides to millions with two decimals.
	measure 'Average Order Value' = DIVIDE([Fulfilled Sales Proxy], [Delivered Orders])
		formatString: #,##0
		displayFolder: Currency (VND)
		lineageTag: 44b643d1-5262-45b7-ad81-ba94a03fbba2

	/// Product COGS proxy on delivered lines.
	measure 'Fulfilled COGS Proxy' = SUM('fct_order_item'[fulfilled_cogs_proxy])
		formatString: #,##0.00
		displayFolder: Currency (VND)
		lineageTag: 283c1dcb-f4b1-476f-a0d3-5863bce0c7f9

	/// Sales proxy less COGS proxy; excludes tax, shipping and overhead.
	measure 'Gross Margin Proxy' = [Fulfilled Sales Proxy] - [Fulfilled COGS Proxy]
		formatString: #,##0.00
		displayFolder: Currency (VND)
		lineageTag: cf2d6490-3636-4f02-b867-b89bf546330f

	/// Gross margin proxy divided by fulfilled sales proxy.
	measure 'Margin Proxy %' = DIVIDE([Gross Margin Proxy], [Fulfilled Sales Proxy])
		formatString: 0.0%
		displayFolder: Percentages
		lineageTag: 9a65359c-08d8-4c14-b017-ca55d0febe77

	/// Previous month fulfilled sales proxy by order date.
	measure 'Previous Month Sales' = CALCULATE([Fulfilled Sales Proxy], DATEADD('dim_date'[calendar_date], -1, MONTH))
		formatString: #,##0.00
		displayFolder: Currency (VND)
		lineageTag: 006c56b9-04f0-46bf-8fcb-b92b715bf832

	/// Month-over-month change in fulfilled sales proxy.
	measure 'MoM Sales Growth %' = DIVIDE([Fulfilled Sales Proxy] - [Previous Month Sales], [Previous Month Sales])
		formatString: 0.0%
		displayFolder: Percentages
		lineageTag: b549ecf2-0f81-4069-93fa-61110f53942b

	/// Visible source and metric caveat.
	measure 'Demo Data Notice' = "DEMO ONLY • Currency VND • sales proxy is not recognized revenue."
		displayFolder: Report Notes
		lineageTag: 9f8b142a-53ed-40e8-bc6d-cce2e8e435fd

	/// Explains the deliberate omission of the inventory fact.
	measure 'Inventory Scope Note' = "Global inventory is excluded from this regional RLS model because it has no geography key."
		displayFolder: Report Notes
		lineageTag: 7b8c73d1-498d-4344-b7d8-ea8a2d51f715

	/// Distinct delivered item-line denominator.
	measure 'Delivered Item Lines' = CALCULATE(DISTINCTCOUNT('fct_order_item'[order_item_id]), 'fct_order_item'[order_status] = "delivered")
		formatString: #,##0
		displayFolder: Return Rate
		lineageTag: a2f56c19-e148-4df1-b716-ca6e7ec8e110

	/// Completed return events eventually associated with selected delivered item IDs; ignores return-date filtering.
	measure 'Returned Delivered Item Lines (Eventual)' = VAR DeliveredItemIDs = CALCULATETABLE(VALUES('fct_order_item'[order_item_id]), 'fct_order_item'[order_status] = "delivered") RETURN CALCULATE(DISTINCTCOUNT('fct_return'[order_item_id]), REMOVEFILTERS('dim_date'), 'fct_return'[status] = "completed", TREATAS(DeliveredItemIDs, 'fct_return'[order_item_id]))
		formatString: #,##0
		displayFolder: Return Rate
		lineageTag: 0beb2bea-b6d7-4c3e-9bb6-ea5293343a00

	/// Unique delivered item lines with at least one completed return divided by delivered item lines; not a unit-return rate.
	measure 'Return Line Rate' = DIVIDE([Returned Delivered Item Lines (Eventual)], [Delivered Item Lines])
		formatString: 0.0%
		displayFolder: Return Rate
		lineageTag: 1abcc492-8067-4e99-9f1f-e9c72b2eed71

	/// Makes the report date-role rules visible.
	measure 'Return Line Rate Date Rule' = "Late/P90: delivery date; weather: observation date; completed returns by order date; no return-date filter."
		displayFolder: Report Notes
		lineageTag: 556c0fb6-c0f6-4ec5-84c8-a2b7d4214d56

	column order_item_id
		dataType: string
		isHidden
